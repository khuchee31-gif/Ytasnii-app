; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Хот унтлаа"
config/description="Ангийн мафи — онлайн"
run/main_scene="res://scenes/table.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
; ХУВИЛБАР НЬ ДЭЛГЭЦЭН ДЭЭР ГАРНА (ачаалалтын мөрөнд).
;
; Утсан дээр алдаа гарахад «чи аль угсралтыг ажиллуулж байна вэ»
; гэдэг нь хамгийн эхний асуулт. Хэрэглэгч бүртгэл харах боломжгүй
; тул хувилбарыг ХАРАГДАХ газар бичнэ. Угсрах бүрд шинэчилнэ.
config/version="0.2"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
; ГАР УТСАНД MSAA УНТРААЛТТАЙ.
;
; godotengine/godot#104351: «Gray Artifact on moving MeshInstance3D when
; using 3D MSAA on Low End Android Device with Compatibility renderer» —
; яг PowerVR Rogue дээр, Redmi 9C дээр бүртгэгдсэн. Манай зорилтот
; төхөөрөмж нь Redmi 9A, ЯГ ТЭР GPU гэр бүл (GE8320).
;
; 720p дээр 2x MSAA нь бараг юу ч нэмэхгүй атлаа хавтангийн
; архитектурт зурвасын өргөн иддэг. Ширээний хөгжүүлэлтэд хэвээр.
anti_aliasing/quality/msaa_3d.mobile=0
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
