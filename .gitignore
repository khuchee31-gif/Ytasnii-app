# Godot
game/.godot/
game/android/
game/*.tmp

# `game/override.cfg` — Godot-ийн төслийн тохиргоог ДАРЖ бичдэг файл.
#
# Зөвхөн нэг машин дээрх түр зуурын туршилтад: жишээ нь бичлэг авахад
# MSAA-г унтраан хурдасгах. Энэ нь тухайн ажлынх болохоос төслийнх
# биш — git-д орвол дараагийн хүн мэдэлгүй өөр тохиргоотой угсарна.
game/override.cfg

# `game/export_presets.cfg` нь ЗОРИУДААР ЭНД БАЙХГҮЙ.
#
# Өмнө нь энд байсан. Тэр нь чимээгүй алдагдал үүсгэсэн: APK-г ямар
# архитектур, ямар зөвшөөрөлтэй угсрах вэ гэдэг нь ЗӨВХӨН нэг
# хөгжүүлэлтийн машин дээр амьдардаг байв. Контейнер дахин
# үүсэхэд бүх тохиргоо алга болж, APK дахин эвдэрсэн хэлбэрээр
# угсрагдана — тоглогч «нээгээд шууд хаагдлаа» гэж л мэдэрнэ,
# шалтгаан нь хаана ч бичигдээгүй.
#
# Дотор нь нууц зүйл БАЙХГҮЙ: дибаг түлхүүрийн зам ба Android-ын
# нийтэд мэдэгдсэн «android» нууц үг. Түлхүүрийн ФАЙЛ өөрөө git-д
# ОРООГҮЙ.

# Түр зуурын дүрслэлийн гаралт
game/shots/

# Бэлэн APK. Хоёртын файл git-д хэрэггүй — `tools/` -оор дахин угсарна.
build/
